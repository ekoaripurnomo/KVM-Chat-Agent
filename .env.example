# ---------------------------------------------------------------------------
# KVM Chat Agent configuration
# Copy to backend/.env and fill in. NEVER commit real secrets.
# ---------------------------------------------------------------------------

# --- Server ---
PORT=8787
# Comma-separated list of allowed CORS origins for the frontend
CORS_ORIGIN=http://localhost:5173

# --- LLM provider (OpenAI-compatible) ---
LLM_BASE_URL=http://172.18.101.88:8080/v1
LLM_MODEL=gpt-oss
# Secret. Provide via environment / secret manager. Do NOT commit.
LLM_API_KEY=
# Request timeout in milliseconds
LLM_TIMEOUT_MS=60000

# --- Policy limits (administrative maximums) ---
MAX_VM_VCPU=16
MAX_VM_MEMORY_MB=32768
MAX_VM_DISK_GB=500

# --- Application defaults (admin-configured; NOT invented by the LLM) ---
DEFAULT_NETWORK=brforvms
DEFAULT_DISK_GB=20
DEFAULT_OS_VARIANT=generic
DEFAULT_DISPLAY=vnc

# --- MCP integration ---
# "mock"  -> in-process fake MCP server (safe, no real VMs). Great for demos/tests.
# "stdio" -> spawn a real kvm-mcp process and talk JSON-RPC over stdio.
MCP_MODE=mock
# Command + args used when MCP_MODE=stdio (space-separated args in MCP_SERVER_ARGS)
MCP_SERVER_COMMAND=python3
MCP_SERVER_ARGS=kvm_mcp_server.py
MCP_SERVER_CWD=
# Host-side artifact required by the real kvm-mcp create_vm tool.
# If empty, create_vm will fail with an explicit error instead of guessing.
MCP_DEFAULT_MASTER_IMAGE=
MCP_CALL_TIMEOUT_MS=120000

# --- Audit log ---
AUDIT_LOG_FILE=./audit/audit.log
